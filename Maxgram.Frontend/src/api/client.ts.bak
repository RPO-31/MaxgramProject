interface Conversation {
  id: number;
  type: 'Private' | 'Group';
  title: string;
  lastMessage: string | null;
  lastMessageAuthor: string | null;
  lastMessageAt: string | null;
}

const API_BASE = 'https://localhost:7029/api';

async function request<T>(endpoint: string, options: RequestInit = {}): Promise<T> {
  const response = await fetch(`${API_BASE}${endpoint}`, {
    ...options,
    credentials: 'include',
    headers: {
      'Content-Type': 'application/json',
      ...options.headers,
    },
  });

  if (!response.ok) {
    const error = await response.json().catch(() => ({ message: 'Unknown error' }));
    throw new Error(error.message || `HTTP ${response.status}`);
  }

  return response.json();
}

// Auth
export const authApi = {
  register: (data: { username: string; displayName: string; email: string; password: string; confirmPassword: string }) =>
    request('/auth/register', { method: 'POST', body: JSON.stringify(data) }),

  login: (data: { usernameOrEmail: string; password: string }) =>
    request<{ id: number; username: string; displayName: string; email: string }>('/auth/login', {
      method: 'POST',
      body: JSON.stringify(data),
    }),

  logout: () => request('/auth/logout', { method: 'POST' }),

  me: () => request<{ id: number; username: string; displayName: string; email: string }>('/auth/me'),
};

// Chats
export const chatsApi = {
  getAll: () => request<any[]>('/chats'),

  getById: (id: number) => request<any>(`/chats/${id}`),

  createPrivate: (userId: number) =>
    request<Conversation>('/chats/private', { method: 'POST', body: JSON.stringify({ userId }) }),

  createGroup: (title: string, participantIds: number[]) =>
    request<Conversation>('/chats/group', { method: 'POST', body: JSON.stringify({ title, participantIds }) }),

  getMessages: (chatId: number, page = 1, pageSize = 20) =>
    request<any>(`/chats/${chatId}/messages?page=${page}&pageSize=${pageSize}`),

  sendMessage: (chatId: number, text: string) =>
    request(`/chats/${chatId}/messages`, { method: 'POST', body: JSON.stringify({ text }) }),
};

// Users
export const usersApi = {
  search: (query?: string) =>
    request<any[]>(`/users${query ? `?search=${encodeURIComponent(query)}` : ''}`),
};